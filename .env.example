TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_GROUP_ID=
# ModemManager Device (ID_MM_PHYSDEV_UID from the setup script, or mmcli Device)
MODEM_UID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./secrets/google-token.json
DATABASE_PATH=./data/telesms.sqlite
CONTACTS_SYNC_INTERVAL_SECS=21600
DEFAULT_REGION=IR
# STATUS_TZ=Asia/Tehran
# Delete SMS from the modem after the daemon handles them (default true).
# SMS_DELETE_ENABLED=true
# Sweep leftovers older than this many days (default 30). Unmarked inbound younger than 24h is never swept.
# SMS_DELETE_MAX_AGE_DAYS=30
